# Public URL of the production site, used for canonical URLs, Open Graph tags,
# the sitemap and robots.txt. Set this when you connect a custom domain.
#
# If unset, the site falls back to Vercel's production domain
# (VERCEL_PROJECT_PRODUCTION_URL), then to https://shubhamworks.vercel.app.
#
# NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Web3Forms access key for the contact form (get one free at https://web3forms.com,
# using the inbox that should receive messages). Read at build time and sent to the
# browser, because Web3Forms only accepts browser submissions on the free plan. It is
# public by design - it only routes submissions to your inbox. If unset, the form opens
# the visitor's email app (mailto:).
#
# WEB3FORMS_ACCESS_KEY=your-access-key
